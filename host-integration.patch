@@ -0,0 +1,23 @@
+//! Uses exactly the same signed Git download/install path as the application.
+use rill_core::{models::Repository,index::Index};
+fn main(){if let Err(error)=run(){eprintln!("{error}");std::process::exit(1)}}
+fn run()->rill_core::Result<()>{
+    let args=std::env::args().collect::<Vec<_>>();
+    if args.len()!=3{return Err("Usage: install_reader <Rill data directory> <publisher.json>".into())}
+    let base=std::path::Path::new(&args[1]);std::fs::create_dir_all(base).map_err(|e|e.to_string())?;
+    let mut value:serde_json::Value=serde_json::from_slice(&std::fs::read(&args[2]).map_err(|e|e.to_string())?).map_err(|e|e.to_string())?;
+    value["id"]=serde_json::json!(format!("{}:{}",value["owner"].as_str().unwrap_or(""),value["repo"].as_str().unwrap_or("")));
+    let repository:Repository=serde_json::from_value(value).map_err(|e|e.to_string())?;repository.validate()?;
+    let mut index=Index::open(&base.join("rill.sqlite"))?;
+    let mut sources=index.repositories()?;
+    if let Some(old)=sources.iter().find(|r|r.id==repository.id){if old.public_key!=repository.public_key{return Err("已有仓库绑定了不同的发布者公钥，已停止".into())}}
+    else{sources.push(repository.clone());index.put("repositories",&sources)?;}
+    let download=rill_core::updates::download_latest(&repository)?;
+    let bundle=rill_core::packages::verify_zip(download.path(),&base.join("staging"),&rill_core::packages::publisher_key(&repository.public_key)?)?;
+    let mut plugins=index.plugins()?;
+    if plugins.iter().any(|p|p.id==bundle.manifest.id&&p.version==bundle.manifest.version){println!("Reader version already installed");return Ok(())}
+    let (installed,path)=rill_core::packages::commit_bundle(bundle,&base.join("plugins"),&plugins)?;
+    plugins.retain(|p|p.id!=installed.id);plugins.push(installed);index.put("plugins",&plugins)?;
+    rill_core::reader::call(base,&mut index,"state",&serde_json::json!({}),&|_,_|Err("Not used".into()))?;
+    println!("Installed from Git: {}",path.display());Ok(())
+}

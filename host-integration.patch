+//! Narrow external-reader port. Every file read is checked against the saved table/view binding.
+use crate::{Result, index::Index, models::{Manifest,Root,NoteEntry}, table_records::Store};
+use serde_json::{Value,json};
+use sha2::{Digest,Sha256};
+use std::path::{Path,PathBuf};
+pub const STATE_TABLE:&str="rill-reader-state";
+pub fn verified(base:&Path,index:&Index,id:&str)->Result<(Manifest,PathBuf)> {
+    if !crate::packages::valid_id(id){return Err("插件标识无效".into())}
+    let plugin=index.plugins()?.into_iter().find(|p|p.id==id&&p.enabled).ok_or("插件未安装或已关闭")?;
+    if !crate::packages::valid_version(&plugin.version){return Err("插件版本无效".into())}
+    let repository=index.repositories()?.into_iter().find(|r|crate::packages::publisher_key(&r.public_key).map(|key|crate::packages::publisher_id(&key)==plugin.publisher).unwrap_or(false)).ok_or("发布者公钥已撤销")?;
+    let path=base.join("plugins").join(id).join(&plugin.version);
+    let manifest=crate::packages::verify_directory(&path,&crate::packages::publisher_key(&repository.public_key)?)?;
+    if manifest.id!=plugin.id||manifest.version!=plugin.version{return Err("插件登记与签名包不一致".into())}
+    Ok((manifest,path))
+}
+fn provision(base:&Path,index:&mut Index)->Result<Store>{
+    let store=Store::open(base,STATE_TABLE)?;
+    let mut config:Value=index.get("data_config")?.unwrap_or_else(||json!({"version":1,"tables":[]}));
+    let tables=config["tables"].as_array_mut().ok_or("多维表配置损坏")?;
+    let source=format!("managed:{STATE_TABLE}");
+    if !tables.iter().any(|t|t["id"]==STATE_TABLE){
+        if tables.len()>=100{return Err("多维表数量已达上限".into())}
+        tables.push(json!({"id":STATE_TABLE,"name":"阅读器 · 阅读进度","folders":[{"sourceId":source,"folder":""}],"filters":[],"views":[{"id":"all","name":"全部记录","filters":[],"columns":[],"sortField":"$name","descending":false}],"writeTarget":source}));
+        index.put("data_config",&config)?;
+    }else{
+        let table=tables.iter().find(|t|t["id"]==STATE_TABLE).unwrap();
+        if table["writeTarget"]!=source||!table["folders"].as_array().is_some_and(|folders|folders.iter().any(|f|f["sourceId"]==source&&f["folder"]=="")){return Err("阅读进度表的写入目标已修改，请恢复后重试".into())}
+    }
+    let root=Root{id:source,name:"阅读器 · 阅读进度".into(),locator:base.join("table-records").join(STATE_TABLE).to_string_lossy().into_owned()};
+    use crate::documents::DocumentSource;
+    index.connect_metadata(&root,&crate::documents::DesktopDocuments.list(&root)?)?;
+    Ok(store)
+}
+fn state(store:&Store)->Result<Value>{
+    if store.ids()?.iter().any(|id|id=="settings"){Ok(Value::Object(store.get("settings")?.fields))}else{Ok(json!({}))}
+}
+fn save(store:&Store,id:&str,fields:Value)->Result<()> {
+    let fields=fields.as_object().ok_or("阅读状态无效")?.clone();
+    if store.ids()?.iter().any(|entry|entry==id){let old=store.get(id)?;store.update(id,&old.version,fields,&[])?;}else{store.restore(id,fields)?;}
+    Ok(())
+}
+pub fn position_id(source:&str,id:&str)->String{format!("{:x}",Sha256::digest(format!("{source}\0{id}").as_bytes()))}
+fn binding<'a>(config:&'a Value,value:&Value)->Result<(&'a Value,String,Option<String>)>{
+    let id=value["tableId"].as_str().ok_or("请先在书库设置中选择数据表")?;
+    let table=config["tables"].as_array().and_then(|tables|tables.iter().find(|t|t["id"]==id)).ok_or("绑定的数据表已删除")?;
+    if id==STATE_TABLE{return Err("阅读进度表不能作为 EPUB 书库".into())}
+    let view=value["viewId"].as_str().filter(|s|!s.is_empty()).map(str::to_owned);
+    if let Some(view)=&view{if !table["views"].as_array().is_some_and(|views|views.iter().any(|v|v["id"]==*view)){return Err("绑定的视图已删除".into())}}
+    Ok((table,id.into(),view))
+}
+pub fn authorize(config:&Value,value:&Value,root:&Root,note:&NoteEntry)->Result<()> {
+    if !note.path.to_ascii_lowercase().ends_with(".epub"){return Err("只能读取 EPUB 记录".into())}
+    let (_,table,view)=binding(config,value)?;
+    crate::media::authorize_record(config,&table,view.as_deref(),root,note)
+}
+pub fn call(base:&Path,index:&mut Index,action:&str,request:&Value,read:&dyn Fn(&Root,&NoteEntry)->Result<Vec<u8>>)->Result<Value>{
+    let (manifest,_)=verified(base,index,"rill.reader")?;
+    let capability=if matches!(action,"saveState"|"savePosition"){"reader.state.write"}else{"tables.epub.read"};
+    if !manifest.capabilities.iter().any(|c|c==capability){return Err("阅读器未获此能力授权".into())}
+    let store=provision(base,index)?;
+    let current=state(&store)?;
+    let config:Value=index.get("data_config")?.ok_or("多维表配置不存在")?;
+    if action=="state"{return Ok(current)}
+    if action=="tables"{return Ok(Value::Array(config["tables"].as_array().ok_or("多维表配置损坏")?.iter().filter(|t|t["id"]!=STATE_TABLE).map(|table|json!({"id":table["id"],"name":table["name"],"views":table["views"].as_array().map(|views|views.iter().map(|view|json!({"id":view["id"],"name":view["name"]})).collect::<Vec<_>>()).unwrap_or_default()})).collect()))}
+    if action=="saveState"{
+        binding(&config,&request["binding"])?;
+        let font=request["fontSize"].as_u64().filter(|n|(14..=30).contains(n)).ok_or("字号无效")?;
+        let theme=request["theme"].as_str().filter(|s|["paper","sepia","night"].contains(s)).ok_or("纸张主题无效")?;
+        save(&store,"settings",json!({"kind":"reader.settings","title":"阅读器设置","binding":request["binding"],"fontSize":font,"theme":theme}))?;
+        provision(base,index)?;return Ok(Value::Null)
+    }
+    if request["binding"]!=current["binding"]{return Err("书库绑定已更改，请重新打开阅读器".into())}
+    let (table,_,_)=binding(&config,&current["binding"])?;
+    let roots=index.roots()?;
+    let errors:std::collections::BTreeMap<String,String>=index.get("data_source_errors")?.unwrap_or_default();
+    for folder in table["folders"].as_array().ok_or("表范围损坏")?{
+        let source=folder["sourceId"].as_str().ok_or("来源标识损坏")?;
+        if !roots.iter().any(|r|r.id==source)||errors.contains_key(source){return Err("书库来源离线或授权失效，请在多维表恢复连接".into())}
+    }
+    if action=="query"{
+        let mut books=Vec::new();
+        for root in roots.iter().filter(|r|table["folders"].as_array().unwrap().iter().any(|f|f["sourceId"]==r.id)){
+            for offset in (0..100000).step_by(500){let notes=index.notes_page(root,offset,500)?;let done=notes.len()<500;
+                for note in notes{if note.path.to_ascii_lowercase().ends_with(".epub")&&authorize(&config,&current["binding"],root,&note).is_ok(){let mut value=serde_json::to_value(note).map_err(|e|e.to_string())?;value["sourceId"]=Value::String(root.id.clone());books.push(value);}}
+                if done{break}if offset==99500{return Err("书库索引超过 100000 条，请缩小表范围".into())}
+            }
+        }
+        books.sort_by(|a,b|a["name"].as_str().cmp(&b["name"].as_str()));return Ok(Value::Array(books))
+    }
+    if !matches!(action,"open"|"savePosition"){return Err("不支持此阅读器操作".into())}
+    let source=request["record"]["sourceId"].as_str().ok_or("缺少书籍来源")?;
+    let id=request["record"]["id"].as_str().ok_or("缺少书籍记录")?;
+    let root=roots.iter().find(|r|r.id==source).ok_or("书籍来源已删除")?;
+    let note=index.note(root,id)?;authorize(&config,&current["binding"],root,&note)?;
+    let key=position_id(source,id);
+    if action=="open"{
+        if note.size>8*1024*1024{return Err("第一版支持最大 8 MiB 的 EPUB".into())}
+        let bytes=read(root,&note)?;
+        if bytes.len()>8*1024*1024{return Err("第一版支持最大 8 MiB 的 EPUB".into())}
+        use base64::Engine;
+        let saved=if store.ids()?.contains(&key){Value::Object(store.get(&key)?.fields)["position"].clone()}else{Value::Null};
+        return Ok(json!({"data":base64::engine::general_purpose::STANDARD.encode(bytes),"position":saved}))
+    }
+    let position=&request["position"];
+    if position["chapter"].as_str().is_none_or(|s|s.len()>1000)||position["ratio"].as_f64().is_none_or(|n|!n.is_finite()||!(0.0..=1.0).contains(&n))||position["modified"].as_i64()!=Some(note.modified)||position["size"].as_u64()!=Some(note.size){return Err("阅读进度无效或书籍已被外部修改".into())}
+    save(&store,&key,json!({"kind":"reader.progress","title":note.name,"sourceId":source,"recordId":id,"position":position}))?;
+    provision(base,index)?;Ok(Value::Null)
+}

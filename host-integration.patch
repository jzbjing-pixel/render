@@ -0,0 +1,46 @@
+import {useEffect,useRef,useState} from 'react';
+import {host} from '../host';
+import type {PluginEntry} from '../domain';
+
+/** Downloaded code has an opaque origin, no host DOM and no direct native or network access. */
+export function ExternalPlugin({plugin,onDirtyChange}:{plugin:PluginEntry;onDirtyChange?:(dirty:boolean)=>void}) {
+  const frame=useRef<HTMLIFrameElement>(null);
+  const dirtyCallback=useRef(onDirtyChange);dirtyCallback.current=onDirtyChange;
+  const [url,setUrl]=useState(''),[error,setError]=useState('');
+  useEffect(()=>{
+    let active=true;let channel:MessageChannel|undefined;
+    setUrl('');setError('');
+    void (async()=>{
+      if(!host.externalPluginBundle||!host.readerRpc)throw Error('此客户端尚未接入外部插件运行，请更新 Rill');
+      const bundle=await host.externalPluginBundle(plugin.id);
+      if(!active)return;
+      if(bundle.manifest.id!==plugin.id)throw Error('插件登记与加载包不一致');
+      const origin=['windows','android'].includes((await host.snapshot()).platform)?'http://rill-plugin.localhost':'rill-plugin://localhost';
+      if(!active)return;
+      setUrl(`${origin}/${encodeURIComponent(plugin.id)}/${encodeURIComponent(plugin.version)}/index.html`);
+      const initialize=()=>{
+        if(!active||!frame.current?.contentWindow)return;
+        channel?.port1.close();channel=new MessageChannel();let pending=0;
+        channel.port1.onmessage=event=>{
+          const value=event.data;
+          if(!active||!value||!Number.isSafeInteger(value.id)||value.id<=0||typeof value.action!=='string'||pending>=8)return;
+          if(value.action==='dirty'){dirtyCallback.current?.(Boolean(value.request?.dirty));channel?.port1.postMessage({id:value.id,result:null});return;}
+          const port=channel!.port1;++pending;
+          void (async()=>{
+            try{
+              if(plugin.id!=='rill.reader')throw Error('此插件尚未接入数据访问能力');
+              const result=await host.readerRpc!(value.action,value.request??{});
+              if(active)port.postMessage({id:value.id,result});
+            }catch(error){if(active)port.postMessage({id:value.id,error:error instanceof Error?error.message:'插件请求失败'});}
+            finally{--pending;}
+          })();
+        };
+        frame.current.contentWindow.postMessage({type:'rill:init'},'*',[channel.port2]);
+      };
+      // React may commit the new URL after this continuation; use the load event.
+      if(frame.current)frame.current.onload=initialize;
+    })().catch(error=>{if(active)setError(error.message);});
+    return()=>{active=false;channel?.port1.close();dirtyCallback.current?.(false);};
+  },[plugin.id,plugin.version]);
+  return error?<div role="alert" className="plugin-workspace"><p>{error}</p></div>:<iframe ref={frame} src={url||undefined} title={plugin.name} sandbox="allow-scripts" referrerPolicy="no-referrer" className="external-plugin-frame" style={{width:'100%',height:'calc(100dvh - 120px)',minHeight:320,border:0,borderRadius:12}} />;
+}

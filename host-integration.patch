+    let mut config:serde_json::Value=index.get("data_config").unwrap().unwrap();config["tables"][0]["filters"]=json!([{"field":"$type","operator":"equals","value":"mp3"}]);index.put("data_config",&config).unwrap();assert!(reader::call(base,&mut index,"open",&request,&read).is_err());

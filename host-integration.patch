+    index.put("plugins",&vec![PluginEntry{id:"rill.reader".into(),name:"Reader".into(),version:"0.1.0".into(),previous_version:None,installed_at:1,publisher:packages::publisher_id(key),enabled:true}]).unwrap();
+    let books=base.join("books");std::fs::create_dir(&books).unwrap();std::fs::write(books.join("book.epub"),b"PKtest").unwrap();

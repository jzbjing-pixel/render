+    let code=b"/* reader test entry */";std::fs::write(path.join("main.js"),code).unwrap();
+    let manifest=Manifest{format:1,id:"rill.reader".into(),name:"Reader".into(),version:"0.1.0".into(),min_host_api:1,entry:"main.js".into(),capabilities:vec!["ui.render".into(),"tables.epub.read".into(),"reader.state.write".into()],files:vec![BundleFile{path:"main.js".into(),bytes:code.len() as u64,sha256:format!("{:x}",Sha256::digest(code))}]};
+    let bytes=serde_json::to_vec(&manifest).unwrap();let signature:Signature=signing.sign(&bytes);std::fs::write(path.join("manifest.json"),&bytes).unwrap();std::fs::write(path.join("manifest.sig"),base64::engine::general_purpose::STANDARD.encode(signature.to_der().as_bytes())).unwrap();
+    let mut index=Index::open(&base.join("rill.sqlite")).unwrap();

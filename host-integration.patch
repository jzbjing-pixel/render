+use tauri::{AppHandle,Manager,http::Response};
+use crate::kernel::Shared;
+pub fn serve(app:&AppHandle,path:&str)->Response<Vec<u8>>{
+    let response=(||->rill_core::Result<(&'static str,Vec<u8>)>{
+        let parts=path.trim_start_matches('/').split('/').collect::<Vec<_>>();
+        if parts.len()!=3||!matches!(parts[2],"index.html"|"main.js"){return Err("插件资源不存在".into())}
+        let shared=app.state::<Shared>();
+        let _operation=shared.operation.lock().map_err(|_|"插件暂不可用")?;
+        let index=shared.index.lock().map_err(|_|"插件登记暂不可用")?;
+        let (manifest,directory)=rill_core::reader::verified(&shared.data,&index,parts[0])?;
+        if manifest.version!=parts[1]||!manifest.capabilities.iter().any(|c|c=="ui.render"){return Err("插件版本或界面授权已失效".into())}
+        if parts[2]=="main.js"{return Ok(("text/javascript; charset=utf-8",std::fs::read(directory.join(manifest.entry)).map_err(|e|e.to_string())?))}
+        let origin=if cfg!(any(target_os="windows",target_os="android")){"http://rill-plugin.localhost"}else{"rill-plugin://localhost"};
+        let html=format!("<!doctype html><html lang=\"zh-CN\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"></head><body><script src=\"{origin}/{}/{}/main.js\"></script></body></html>",manifest.id,manifest.version);
+        Ok(("text/html; charset=utf-8",html.into_bytes()))
+    })();
+    let origin=if cfg!(any(target_os="windows",target_os="android")){"http://rill-plugin.localhost"}else{"rill-plugin:"};
+    let csp=format!("default-src 'none'; script-src {origin}; style-src 'unsafe-inline'; img-src blob: data:; connect-src 'none'; frame-src 'none'; object-src 'none'; base-uri 'none'; form-action 'none'");
+    match response{
+        Ok((mime,body))=>Response::builder().header("Content-Type",mime).header("Content-Security-Policy",csp).header("Cache-Control","no-store").header("X-Content-Type-Options","nosniff").body(body).unwrap(),
+        Err(error)=>Response::builder().status(403).header("Content-Type","text/plain; charset=utf-8").body(error.into_bytes()).unwrap()
+    }
+}

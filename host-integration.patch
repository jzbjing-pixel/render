+/// Fetch a Git-backed package from one immutable commit before normal signature verification.
+pub fn download_git(repository:&Repository)->Result<tempfile::NamedTempFile>{
+    repository.validate()?;
+    let client=Client::builder().timeout(Duration::from_secs(45)).connect_timeout(Duration::from_secs(10)).user_agent("Rill/0.1.5").redirect(reqwest::redirect::Policy::none()).build().map_err(|e|e.to_string())?;
+    let response=client.get(format!("https://api.github.com/repos/{}/{}/commits?per_page=1",repository.owner,repository.repo)).send().and_then(|r|r.error_for_status()).map_err(|_|"无法获取 Git 仓库版本，请检查网络")?;
+    let mut bytes=Vec::new();response.take(1024*1024+1).read_to_end(&mut bytes).map_err(|e|e.to_string())?;
+    if bytes.len()>1024*1024{return Err("Git 仓库版本响应过大".into())}
+    let commits:Value=serde_json::from_slice(&bytes).map_err(|_|"Git 仓库版本响应无效")?;
+    let sha=commits[0]["sha"].as_str().filter(|s|s.len()==40&&s.bytes().all(|c|c.is_ascii_hexdigit())).ok_or("Git 仓库版本标识无效")?;
+    let mut response=client.get(format!("https://raw.githubusercontent.com/{}/{}/{sha}/dist/{}",repository.owner,repository.repo,repository.asset)).send().and_then(|r|r.error_for_status()).map_err(|_|"Git 仓库中未找到已构建的插件包")?;
+    let mut temp=tempfile::NamedTempFile::new().map_err(|e|e.to_string())?;
+    let mut count=0;let mut buffer=[0u8;8192];
+    loop{let n=response.read(&mut buffer).map_err(|_|"Git 插件下载中断")?;if n==0{break}count+=n;if count>20*1024*1024{return Err("插件包超过 20 MiB".into())}temp.write_all(&buffer[..n]).map_err(|e|e.to_string())?;}
+    temp.as_file().sync_all().map_err(|e|e.to_string())?;Ok(temp)
+}
